# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/my_money

# Identity
# Production login is handled by Azure Easy Auth; the app only reads the
# identity headers it injects. These set the local dev identity (no login).
DEV_AUTH_USER_ID=1
DEV_AUTH_USERNAME=zachery

# Bearer key protecting the /mcp endpoint (required in production; leave
# empty locally). Agents send: Authorization: Bearer <key>
MCP_API_KEY=

# Encrypts API keys stored in the database (Settings -> API Keys).
# Generate: openssl rand -base64 32
# Losing this key orphans DB-stored secrets (env fallbacks below still work;
# users just re-enter their keys after a rotation).
SECRETS_ENCRYPTION_KEY=

# API Keys -- env values act as fallbacks when no key is stored in the DB.
CMC_PRO_API_KEY=your-coinmarketcap-api-key
CG_API_KEY=your-coingecko-api-key

# Etherscan V2 -- one key for chains using the default provider.
# Base (8453) uses the separately stored per-user Coinbase CDP key. Gnosis
# (100) uses the separately stored per-user Moralis key. Neither key belongs
# in this environment file.
# Restrict the enabled set with comma-separated ids; e.g. 1 for mainnet only.
ETHERSCAN_API_KEY=
ETH_CHAINS=

# Plaid (https://dashboard.plaid.com)
PLAID_CLIENT_ID=
PLAID_SECRET=
# 'sandbox' for testing with fake credentials, 'production' for real banks
PLAID_ENV=sandbox

# Google Sheets Export
GOOGLE_SHEETS_ID=your-spreadsheet-id-from-google-sheets-url

# Production-only
# Comma-separated allowlist of sign-in emails. An allowlisted email's first
# Google sign-in auto-creates its user. Empty list rejects everyone.
ALLOWED_PRINCIPALS=
# Comma-separated list of allowed frontend origins (required when NODE_ENV=production).
# Example: CORS_ORIGIN=https://my-money.example.com,https://www.my-money.example.com
CORS_ORIGIN=
# Set to "false" on additional scaled instances so cron jobs only run on one worker.
RUN_SCHEDULED_JOBS=true

# Optional comma-separated browser origins allowed to call the authenticated
# remote MCP endpoint. Non-browser MCP clients generally do not send Origin.
MCP_ALLOWED_ORIGINS=
